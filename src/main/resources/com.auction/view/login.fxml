<?xml version="1.0" encoding="UTF-8"?>
        prefWidth="1200" prefHeight="800"
        styleClass="app-root">

<center>
    <HBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
        <children>
            <VBox prefWidth="420" maxWidth="420" spacing="18" styleClass="glass-panel">
                <padding>
                    <Insets top="36" right="36" bottom="36" left="36"/>
                </padding>
                <children>
                    <Label text="AuctionHub" styleClass="brand-title"/>
                    <Label text="Đăng nhập hệ thống đấu giá trực tuyến" styleClass="page-subtitle" wrapText="true"/>

                    <VBox spacing="8">
                        <Label text="Tên đăng nhập" styleClass="field-label"/>
                        <TextField fx:id="usernameField" promptText="Nhập username" styleClass="text-field-modern"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Mật khẩu" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" styleClass="text-field-modern"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Vai trò" styleClass="field-label"/>
                        <ComboBox fx:id="roleComboBox" promptText="Chọn vai trò" styleClass="combo-modern" prefWidth="999"/>
                    </VBox>

                    <CheckBox fx:id="rememberCheckBox" text="Ghi nhớ đăng nhập" styleClass="check-modern"/>

                    <Label fx:id="messageLabel" text="" styleClass="error-label" wrapText="true"/>

                    <HBox spacing="12">
                        <Button text="Đăng nhập" onAction="#handleLogin" styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="999"/>
                        <Button text="Xóa" onAction="#handleClear" styleClass="secondary-button" HBox.hgrow="ALWAYS" maxWidth="999"/>
                    </HBox>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Chưa có tài khoản?" styleClass="muted-text"/>
                        <Hyperlink text="Đăng ký ngay" onAction="#goToRegister" styleClass="link-modern"/>
                    </HBox>
                </children>
            </VBox>

            <VBox prefWidth="420" maxWidth="420" spacing="20" styleClass="hero-panel">
                <padding>
                    <Insets top="40" right="36" bottom="40" left="36"/>
                </padding>
                <children>
                    <Label text="Realtime Auction" styleClass="hero-title"/>
                    <Label text="Theo dõi giá trực tiếp, đặt giá nhanh, xem lịch sử bid và quản lý phiên đấu giá chuyên nghiệp." styleClass="hero-text" wrapText="true"/>
                    <VBox spacing="14" styleClass="feature-list">
                        <children>
                            <Label text="• Danh sách phiên đấu giá trực quan" styleClass="feature-item"/>
                            <Label text="• Realtime bidding và countdown timer" styleClass="feature-item"/>
                            <Label text="• Quản lý sản phẩm cho Seller" styleClass="feature-item"/>
                            <Label text="• Dashboard riêng cho từng vai trò" styleClass="feature-item"/>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </children>
    </HBox>
</center>
        </BorderPane>