<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1100" styleClass="login-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.LoginController">

    <center>
        <HBox alignment="CENTER" prefHeight="695.0" prefWidth="1034.0" styleClass="login-shell">
            <children>

                  <Pane />

                <VBox spacing="18" styleClass="login-brand">
                    <children>
                        <Label styleClass="login-icon" text="🔨" />

                        <Label maxWidth="Infinity" styleClass="login-title" text="AuctionHub" />

                        <Label styleClass="login-subtitle" text="Sàn đấu giá trực tuyến" wrapText="true" />

                        <Label styleClass="login-slogan" text="Nhanh  - Công bằng - Thông minh" />
                    </children>
                </VBox>

                <VBox spacing="16" styleClass="login-form">
                    <children>

                        <VBox spacing="4" styleClass="login-header">
                            <children>
                                <Label styleClass="form-title" text="Đăng nhập" />

                                <Label styleClass="form-subtitle" text="Tham gia phiên đấu giá và đặt bid tức thì" />
                            </children>
                        </VBox>

                        <VBox spacing="7">
                            <children>
                                <Label styleClass="field-label" text="Tên đăng nhập" />
                                <TextField fx:id="usernameField" promptText="Nhập username" />
                            </children>
                        </VBox>

                        <VBox spacing="7">
                            <children>
                                <Label styleClass="field-label" text="Mật khẩu" />
                                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" />
                            </children>
                        </VBox>

                        <VBox spacing="7">
                            <children>
                                <Label styleClass="field-label" text="Vai trò" />
                                <ComboBox fx:id="roleComboBox" maxWidth="Infinity" />
                            </children>
                        </VBox>

                        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" />

                        <HBox spacing="12">
                            <children>
                                <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Vào sàn đấu giá" HBox.hgrow="ALWAYS" />

                                <Button maxWidth="Infinity" onAction="#handleClear" styleClass="secondary-button" text="Xóa" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="6">
                            <children>
                                <Label styleClass="muted-text" text="Chưa có tài khoản?" />
                                <Hyperlink onAction="#goToRegister" text="Đăng ký để bắt đầu bid" />
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>
