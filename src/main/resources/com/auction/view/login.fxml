<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.LoginController"
            styleClass="auth-root">

    <center>
        <GridPane styleClass="auth-layout">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <VBox GridPane.columnIndex="0"
                  alignment="CENTER_LEFT"
                  spacing="30"
                  styleClass="auth-brand-panel">

                <Region prefHeight="26"/>

                <Label text="AuctionHub"
                       styleClass="brand-logo"/>

                <Label text="Enterprise Auction Platform"
                       styleClass="brand-description"/>

                <VBox spacing="15"
                      styleClass="brand-features">
                    <Label text="• Real-time bidding"
                           styleClass="brand-feature"/>
                    <Label text="• Secure transaction workflow"
                           styleClass="brand-feature"/>
                    <Label text="• Multi-role management"
                           styleClass="brand-feature"/>
                    <Label text="• Live analytics dashboard"
                           styleClass="brand-feature"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Version 1.0"
                       styleClass="brand-footer"/>

                <padding>
                    <Insets top="88" right="64" bottom="72" left="72"/>
                </padding>
            </VBox>

            <StackPane GridPane.columnIndex="1"
                       styleClass="auth-form-area">

                <VBox alignment="CENTER_LEFT"
                      spacing="0"
                      maxWidth="480"
                      translateY="24"
                      styleClass="auth-form">

                    <Label text="Sign in"
                           styleClass="form-title"/>

                    <Label text="Access the auction management workspace"
                           styleClass="form-subtitle"/>

                    <Region prefHeight="38"/>

                    <Label text="Username"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <TextField fx:id="usernameField"
                               promptText="Enter username"
                               styleClass="auth-input"/>

                    <Region prefHeight="24"/>

                    <Label text="Password"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter password"
                                   styleClass="auth-input"/>

                    <Region prefHeight="24"/>

                    <Label text="Role"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <ComboBox fx:id="roleComboBox"
                              prefWidth="260"
                              minWidth="260"
                              prefHeight="52"
                              styleClass="auth-combo"/>

                    <Region prefHeight="36"/>

                    <Button text="Login"
                            prefHeight="50"
                            maxWidth="9999"
                            onAction="#handleLogin"
                            styleClass="primary-button"/>

                    <Region prefHeight="12"/>

                    <Button text="Reset"
                            prefHeight="50"
                            maxWidth="9999"
                            onAction="#handleClear"
                            styleClass="secondary-button"/>

                    <Region prefHeight="24"/>

                    <HBox spacing="10"
                          alignment="CENTER_LEFT">
                        <Label text="No account?"
                               styleClass="muted-text"/>
                        <Hyperlink text="Create one"
                                   onAction="#goToRegister"
                                   styleClass="auth-link"/>
                    </HBox>

                    <Region prefHeight="16"/>

                    <Label fx:id="messageLabel"
                           wrapText="true"
                           styleClass="message-label"/>
                </VBox>
            </StackPane>
        </GridPane>
    </center>
</BorderPane>