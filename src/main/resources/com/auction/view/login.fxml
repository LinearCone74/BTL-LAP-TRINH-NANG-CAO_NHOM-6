<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.LoginController"
            styleClass="auth-container">

    <center>
        <GridPane styleClass="login-shell"
                  maxWidth="1200"
                  maxHeight="720">

            <columnConstraints>
                <ColumnConstraints percentWidth="45"/>
                <ColumnConstraints percentWidth="55"/>
            </columnConstraints>

            <children>

                <!-- LEFT BRAND AREA -->
                <VBox GridPane.columnIndex="0"
                      alignment="CENTER"
                      spacing="26"
                      styleClass="login-left">

                    <children>
                        <Label text="🔨" styleClass="login-icon"/>

                        <Label text="AuctionHub" styleClass="login-brand"/>

                        <Label text="Sàn đấu giá trực tuyến"
                               styleClass="login-brand-subtitle"/>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Label text="Nhanh  -  Công bằng  -  Thông minh"
                               styleClass="login-slogan"/>
                    </children>

                    <padding>
                        <Insets top="70" right="60" bottom="70" left="60"/>
                    </padding>
                </VBox>

                <!-- RIGHT LOGIN AREA -->
                <VBox GridPane.columnIndex="1"
                      alignment="CENTER_LEFT"
                      spacing="16"
                      styleClass="login-right">

                    <children>
                        <Label text="Đăng nhập" styleClass="login-title"/>

                        <Label text="Tham gia phiên đấu giá và đặt bid tức thì"
                               styleClass="login-subtitle"/>

                        <Separator/>

                        <Label text="Tên đăng nhập" styleClass="field-label"/>
                        <TextField fx:id="usernameField"
                                   promptText="Nhập username"
                                   maxWidth="520"/>

                        <Label text="Mật khẩu" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="Nhập mật khẩu"
                                       maxWidth="520"/>

                        <Label text="Vai trò" styleClass="field-label"/>
                        <ComboBox fx:id="roleComboBox"
                                  maxWidth="520"/>

                        <Region prefHeight="28"/>

                        <HBox spacing="16"
                              alignment="CENTER"
                              fillHeight="false">
                            <children>
                                <Button text="Vào sàn đấu giá"
                                        prefWidth="220"
                                        prefHeight="52"
                                        onAction="#handleLogin"
                                        styleClass="primary-button"/>

                                <Button text="Xóa"
                                        prefWidth="220"
                                        prefHeight="52"
                                        onAction="#handleClear"
                                        styleClass="secondary-button"/>
                            </children>
                        </HBox>

                        <HBox spacing="6" alignment="CENTER">
                            <children>
                                <Label text="Chưa có tài khoản?"
                                       styleClass="muted-label"/>

                                <Hyperlink text="Đăng ký để bắt đầu bid"
                                           onAction="#goToRegister"
                                           styleClass="auth-link"/>
                            </children>
                        </HBox>

                        <Label fx:id="messageLabel"
                               wrapText="true"
                               styleClass="success-label"/>
                    </children>

                    <padding>
                        <Insets top="70" right="70" bottom="70" left="70"/>
                    </padding>
                </VBox>

            </children>
        </GridPane>
    </center>

</BorderPane>