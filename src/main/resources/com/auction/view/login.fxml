<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.LoginController"
            prefWidth="1100"
            prefHeight="700"
            styleClass="login-root">

    <center>
        <HBox alignment="CENTER" styleClass="login-shell">
            <children>

                <VBox spacing="18" styleClass="login-brand">
                    <children>
                        <Label text="🔨" styleClass="login-icon"/>

                        <Label text="AuctionHub"
                               styleClass="login-title"
                               maxWidth="Infinity"/>

                        <Label text="Sàn đấu giá trực tuyến"
                               wrapText="true"
                               styleClass="login-subtitle"/>

                        <Pane VBox.vgrow="ALWAYS"/>

                        <Label text="Bid fast • Win fair • Trade smart"
                               styleClass="login-slogan"/>
                    </children>
                </VBox>

                <VBox spacing="16" styleClass="login-form">
                    <children>

                        <VBox spacing="4" styleClass="login-header">
                            <children>
                                <Label text="Đăng nhập"
                                       styleClass="form-title"/>

                                <Label text="Tham gia phiên đấu giá và đặt bid tức thì"
                                       styleClass="form-subtitle"/>
                            </children>
                        </VBox>

                        <VBox spacing="7">
                            <children>
                                <Label text="Tên đăng nhập" styleClass="field-label"/>
                                <TextField fx:id="usernameField" promptText="Nhập username"/>
                            </children>
                        </VBox>

                        <VBox spacing="7">
                            <children>
                                <Label text="Mật khẩu" styleClass="field-label"/>
                                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"/>
                            </children>
                        </VBox>

                        <VBox spacing="7">
                            <children>
                                <Label text="Vai trò" styleClass="field-label"/>
                                <ComboBox fx:id="roleComboBox" maxWidth="Infinity"/>
                            </children>
                        </VBox>

                        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>

                        <HBox spacing="12">
                            <children>
                                <Button text="Vào sàn đấu giá"
                                        onAction="#handleLogin"
                                        styleClass="primary-button"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>

                                <Button text="Xóa"
                                        onAction="#handleClear"
                                        styleClass="secondary-button"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="6">
                            <children>
                                <Label text="Chưa có tài khoản?" styleClass="muted-text"/>
                                <Hyperlink text="Đăng ký để bắt đầu bid" onAction="#goToRegister"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>