<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.DashboardController"
            prefWidth="1280"
            prefHeight="760"
            stylesheets="@../style/app.css"
            styleClass="dashboard-luxury-root">

    <top>
        <VBox spacing="0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="dash-topbar">
                    <padding>
                        <Insets top="10" right="26" bottom="10" left="26"/>
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/auction-logo.png"/>
                                    </image>
                                </ImageView>
                                <VBox spacing="2">
                                    <children>
                                        <Label text="AuctionHub" styleClass="dash-brand"/>
                                        <Label text="Live Auction Marketplace" styleClass="dash-brand-subtitle"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Button text="Làm mới" prefWidth="120" prefHeight="38" onAction="#handleRefresh" styleClass="dash-secondary-button"/>
                        <Button text="Đăng xuất" prefWidth="130" prefHeight="38" onAction="#handleLogout" styleClass="dash-danger-button"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="dash-hero">
                    <padding>
                        <Insets top="12" right="30" bottom="12" left="30"/>
                    </padding>
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="AuctionHub Live Bidding" styleClass="dash-page-title"/>
                                <Label fx:id="welcomeLabel" text="Xin chào" styleClass="dash-welcome"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="dash-tabs">
            <tabs>

                <!-- ==================== TAB 1: PHIÊN ĐẤU GIÁ ==================== -->
                <Tab text="Phiên đấu giá">
                    <content>
                        <BorderPane styleClass="dash-content-card">
                            <top>
                                <VBox spacing="10">
                                    <padding>
                                        <Insets top="16" right="20" bottom="12" left="20"/>
                                    </padding>
                                    <children>
                                        <Label text="Phiên đấu giá đang mở" styleClass="dash-section-title"/>
                                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dash-filter-bar">
                                            <children>
                                                <TextField fx:id="searchField" promptText="Tìm sản phẩm..." HBox.hgrow="ALWAYS" styleClass="dash-input"/>
                                                <ChoiceBox fx:id="statusFilterChoiceBox" prefWidth="180" styleClass="dash-choice"/>
                                                <Button text="Lọc" onAction="#handleFilterAuctions" styleClass="dash-primary-button"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </top>
                            <center>
                                <VBox styleClass="dash-table-wrap">
                                    <padding>
                                        <Insets top="0" right="20" bottom="20" left="20"/>
                                    </padding>
                                    <children>
                                        <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="dash-table">
                                            <columns>
                                                <TableColumn fx:id="colAuctionItem" text="Sản phẩm" prefWidth="320"/>
                                                <TableColumn fx:id="colAuctionSeller" text="Seller" prefWidth="220"/>
                                                <TableColumn fx:id="colAuctionCurrentPrice" text="Giá hiện tại" prefWidth="220"/>
                                                <TableColumn fx:id="colAuctionStatus" text="Trạng thái" prefWidth="180"/>
                                                <TableColumn fx:id="colAuctionEndTime" text="Kết thúc" prefWidth="240"/>
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- ==================== TAB 2: ĐẶT BID REALTIME ==================== -->
                <Tab fx:id="bidRealtimeTab" text="Đặt bid realtime">
                    <content>
                        <VBox spacing="10" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets top="10" right="16" bottom="10" left="16"/>
                            </padding>
                            <children>
                                <HBox spacing="12" VBox.vgrow="NEVER">
                                    <children>
                                        <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="dash-content-card">
                                            <padding>
                                                <Insets top="12" right="16" bottom="12" left="16"/>
                                            </padding>
                                            <children>

                                                <Label text="Chi tiết phiên đấu giá"
                                                       styleClass="dash-section-title"/>

                                                <HBox spacing="30"
                                                      alignment="CENTER_LEFT">

                                                    <children>

                                                        <!-- THÔNG TIN SẢN PHẨM -->
                                                        <GridPane hgap="12"
                                                                  vgap="5">

                                                            <columnConstraints>
                                                                <ColumnConstraints percentWidth="30"/>
                                                                <ColumnConstraints percentWidth="70"/>
                                                            </columnConstraints>

                                                            <children>

                                                                <Label text="Sản phẩm"
                                                                       GridPane.rowIndex="0"/>

                                                                <Label fx:id="itemNameLabel"
                                                                       GridPane.rowIndex="0"
                                                                       GridPane.columnIndex="1"
                                                                       style="-fx-font-weight: bold;"/>

                                                                <Label text="Mô tả"
                                                                       GridPane.rowIndex="1"/>

                                                                <Label fx:id="itemDescriptionLabel"
                                                                       wrapText="true"
                                                                       GridPane.rowIndex="1"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Giá hiện tại"
                                                                       GridPane.rowIndex="2"/>

                                                                <Label fx:id="currentPriceLabel"
                                                                       GridPane.rowIndex="2"
                                                                       GridPane.columnIndex="1"
                                                                       style="-fx-text-fill: #b31b1b; -fx-font-weight: bold;"/>

                                                                <Label text="Người dẫn đầu"
                                                                       GridPane.rowIndex="3"/>

                                                                <Label fx:id="leaderLabel"
                                                                       GridPane.rowIndex="3"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Bắt đầu"
                                                                       GridPane.rowIndex="4"/>

                                                                <Label fx:id="startTimeLabel"
                                                                       GridPane.rowIndex="4"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Kết thúc"
                                                                       GridPane.rowIndex="5"/>

                                                                <Label fx:id="endTimeLabel"
                                                                       GridPane.rowIndex="5"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Trạng thái"
                                                                       GridPane.rowIndex="6"/>

                                                                <Label fx:id="auctionStatusLabel"
                                                                       GridPane.rowIndex="6"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label fx:id="startingPriceLabel"
                                                                       visible="false"
                                                                       managed="false"/>

                                                            </children>
                                                        </GridPane>

                                                        <!-- ẢNH SẢN PHẨM -->
                                                        <StackPane prefWidth="430"
                                                                   prefHeight="250"
                                                                   style="-fx-background-color: transparent;">

                                                            <children>

                                                                <ImageView fx:id="productImageView"
                                                                           fitWidth="430"
                                                                           fitHeight="250"
                                                                           preserveRatio="false"
                                                                           smooth="true">

                                                                    <image>
                                                                        <Image url="@../images/iphone_xs_max.png"/>
                                                                    </image>



                                                                </ImageView>

                                                            </children>
                                                        </StackPane>

                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                        <VBox spacing="8" prefWidth="420" styleClass="dash-content-card">
                                            <padding>
                                                <Insets top="12" right="16" bottom="12" left="16"/>
                                            </padding>
                                            <children>
                                                <Label text="Đặt bid realtime" styleClass="dash-section-title"/>
                                                <HBox spacing="8">
                                                    <TextField fx:id="manualBidField" promptText="Nhập số tiền bid" styleClass="dash-input" HBox.hgrow="ALWAYS"/>
                                                    <Button text="Đặt ngay" prefWidth="90" onAction="#handlePlaceBid" styleClass="dash-primary-button"/>
                                                </HBox>
                                                <Separator style="-fx-padding: 0;"/>
                                                <Label text="Auto Bid" style="-fx-font-weight: bold;"/>
                                                <HBox spacing="8">
                                                    <TextField fx:id="autoBidMaxField" promptText="Giá tối đa" styleClass="dash-input" HBox.hgrow="ALWAYS"/>
                                                    <TextField fx:id="autoBidIncrementField" promptText="Bước nhảy" styleClass="dash-input" HBox.hgrow="ALWAYS"/>
                                                </HBox>
                                                <Button text="Bật Auto Bid" maxWidth="Infinity" onAction="#handleRegisterAutoBid" styleClass="dash-secondary-button"/>
                                                <Label fx:id="bidMessageLabel" wrapText="true" styleClass="success-label"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="12" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox spacing="8" styleClass="dash-content-card" HBox.hgrow="ALWAYS" prefWidth="450">
                                            <padding>
                                                <Insets top="12" right="16" bottom="12" left="16"/>
                                            </padding>
                                            <children>
                                                <Label text="Lịch sử đặt bid" styleClass="dash-section-title"/>
                                                <TableView fx:id="bidHistoryTable" VBox.vgrow="ALWAYS" styleClass="dash-table">
                                                    <columns>
                                                        <TableColumn fx:id="colBidTime" text="Thời gian" prefWidth="150"/>
                                                        <TableColumn fx:id="colBidder" text="Bidder" prefWidth="120"/>
                                                        <TableColumn fx:id="colBidAmount" text="Số tiền" prefWidth="150"/>
                                                        <TableColumn fx:id="colBidType" text="Loại bid" prefWidth="90"/>
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8" styleClass="dash-content-card" HBox.hgrow="ALWAYS" prefWidth="450">
                                            <padding>
                                                <Insets top="12" right="16" bottom="12" left="16"/>
                                            </padding>
                                            <children>
                                                <Label text="Biểu đồ realtime" styleClass="dash-section-title"/>
                                                <LineChart fx:id="priceChart" animated="false" legendVisible="false" VBox.vgrow="ALWAYS" style="-fx-padding: -10;">
                                                    <xAxis>
                                                        <NumberAxis fx:id="xAxis" label="Lượt bid"/>
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis fx:id="yAxis" label="Giá"/>
                                                    </yAxis>
                                                </LineChart>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- ==================== TAB 3: SELLER ==================== -->
                <Tab fx:id="sellerTab" text="Seller">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                            <content>
                                <VBox spacing="20" styleClass="dash-content-card">
                                    <padding>
                                        <Insets top="20" right="24" bottom="20" left="24"/>
                                    </padding>
                                    <children>
                                        <Label text="Quản lý sản phẩm đấu giá" styleClass="dash-page-title" style="-fx-text-fill: black;"/>

                                        <ImageView fx:id="sellerProductImageView"
                                                   fitWidth="430"
                                                   fitHeight="250"
                                                   preserveRatio="false"
                                                   smooth="true">
                                            <image>
                                                <Image url="@../images/iphone_xs_max.png"/>
                                            </image>
                                        </ImageView>

                                        <GridPane hgap="20" vgap="16">
                                            <columnConstraints>
                                                <ColumnConstraints prefWidth="180"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <children>
                                                <Label text="Loại sản phẩm" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                                                <ChoiceBox fx:id="itemTypeChoiceBox" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="dash-choice"/>

                                                <Label text="Tên sản phẩm" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                                                <TextField fx:id="sellerItemNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="dash-input"/>

                                                <Label text="Mô tả" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                                                <TextArea fx:id="sellerItemDescriptionArea" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="dash-input"/>

                                                <Label text="Giá mở phiên" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                                                <TextField fx:id="sellerStartingPriceField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="dash-input"/>

                                                <Label text="Thời gian bắt đầu" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                                                <TextField fx:id="sellerStartTimeField" promptText="yyyy-MM-dd HH:mm" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="dash-input"/>

                                                <Label text="Thời gian kết thúc" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                                                <TextField fx:id="sellerEndTimeField" promptText="yyyy-MM-dd HH:mm" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="dash-input"/>

                                                <Label text="Thuộc tính thêm" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
                                                <TextArea fx:id="sellerMetadataArea" promptText="Ví dụ: Thương hiệu=MSI; Bảo hành=24" prefHeight="60" GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="dash-input"/>
                                            </children>
                                        </GridPane>

                                        <HBox spacing="12">
                                            <Button text="Mở phiên đấu giá" onAction="#handleCreateItem" styleClass="dash-primary-button"/>
                                            <Button text="Cập nhật phiên" onAction="#handleUpdateItem" styleClass="dash-secondary-button" style="-fx-background-color: #4a5568; -fx-text-fill: white;"/>
                                            <Button text="Xóa" onAction="#handleDeleteItem" styleClass="dash-danger-button"/>
                                            <Label fx:id="sellerMessageLabel" styleClass="success-label"/>
                                        </HBox>

                                        <!-- *** THAY ĐỔI DUY NHẤT: thêm fx:id vào 3 cột *** -->
                                        <TableView fx:id="sellerItemTable" VBox.vgrow="ALWAYS" prefHeight="250" styleClass="dash-table">
                                            <columns>
                                                <TableColumn fx:id="colSellerItemName" text="Sản phẩm" prefWidth="400"/>
                                                <TableColumn fx:id="colSellerItemCategory" text="Loại" prefWidth="200"/>
                                                <TableColumn fx:id="colSellerItemPrice" text="Giá mở phiên" prefWidth="200"/>
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                        </TableView>

                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ==================== TAB 4: ADMIN ==================== -->
                <Tab fx:id="adminTab" text="Admin">
                    <content>
                        <VBox spacing="20" styleClass="dash-content-card">
                            <padding>
                                <Insets top="20" right="24" bottom="20" left="24"/>
                            </padding>
                            <children>
                                <Label text="Quản trị người dùng &amp; phiên đấu giá" styleClass="dash-page-title" style="-fx-text-fill: black;"/>

                                <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="dash-table">
                                    <columns>
                                        <TableColumn text="Username" prefWidth="200"/>
                                        <TableColumn text="Họ tên" prefWidth="250"/>
                                        <TableColumn text="Email" prefWidth="250"/>
                                        <TableColumn text="Vai trò" prefWidth="150"/>
                                        <TableColumn text="Trạng thái" prefWidth="150"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="12">
                                    <Button text="Duyệt tài khoản" onAction="#handleApproveUser" styleClass="dash-primary-button"/>
                                    <Button text="Khóa tài khoản" onAction="#handleLockUser" styleClass="dash-danger-button"/>
                                    <Button text="Gỡ phiên đấu giá" onAction="#handleRemoveAuction" styleClass="dash-secondary-button" style="-fx-background-color: #4a5568; -fx-text-fill: white;"/>
                                    <Label fx:id="adminMessageLabel" styleClass="success-label"/>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>