<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.DashboardController"
            prefWidth="1280"
            prefHeight="760"
            stylesheets="@../style/app.css"
            styleClass="dashboard-luxury-root">

    <top>
        <VBox spacing="0">

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="18"
                      styleClass="dash-topbar">

                    <padding>
                        <Insets top="14"
                                right="26"
                                bottom="14"
                                left="26"/>
                    </padding>

                    <children>

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              HBox.hgrow="ALWAYS">

                            <children>

                                <ImageView fitWidth="42"
                                           fitHeight="42"
                                           preserveRatio="true">

                                    <image>
                                        <Image url="@../images/auction-logo.png"/>
                                    </image>

                                </ImageView>

                                <VBox spacing="2">

                                    <children>

                                        <Label text="AuctionHub"
                                               styleClass="dash-brand"/>

                                        <Label text="Live Auction Marketplace"
                                               styleClass="dash-brand-subtitle"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <Button text="Làm mới"
                                prefWidth="120"
                                prefHeight="42"
                                onAction="#handleRefresh"
                                styleClass="dash-secondary-button"/>

                        <Button text="Đăng xuất"
                                prefWidth="130"
                                prefHeight="42"
                                onAction="#handleLogout"
                                styleClass="dash-danger-button"/>

                    </children>

                </HBox>

                <HBox alignment="CENTER_LEFT"
                      spacing="18"
                      styleClass="dash-hero">

                    <padding>
                        <Insets top="22"
                                right="30"
                                bottom="22"
                                left="30"/>
                    </padding>

                    <children>

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <children>

                                <Label text="AuctionHub Live Bidding"
                                       styleClass="dash-page-title"/>

                                <Label fx:id="welcomeLabel"
                                       text="Xin chào"
                                       styleClass="dash-welcome"/>

                            </children>

                        </VBox>

                    </children>

                </HBox>

            </children>

        </VBox>

    </top>

    <center>

        <TabPane fx:id="mainTabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 styleClass="dash-tabs">

            <tabs>

                <!-- ============================= -->
                <!-- AUCTION TAB -->
                <!-- ============================= -->

                <Tab text="Phiên đấu giá">

                    <content>

                        <BorderPane styleClass="dash-content-card">

                            <top>

                                <VBox spacing="14">

                                    <padding>
                                        <Insets top="24"
                                                right="24"
                                                bottom="16"
                                                left="24"/>
                                    </padding>

                                    <children>

                                        <Label text="Phiên đấu giá đang mở"
                                               styleClass="dash-section-title"/>

                                        <HBox spacing="12"
                                              alignment="CENTER_LEFT"
                                              styleClass="dash-filter-bar">

                                            <children>

                                                <TextField fx:id="searchField"
                                                           promptText="Tìm sản phẩm..."
                                                           HBox.hgrow="ALWAYS"
                                                           styleClass="dash-input"/>

                                                <ChoiceBox fx:id="statusFilterChoiceBox"
                                                           prefWidth="180"
                                                           styleClass="dash-choice"/>

                                                <Button text="Lọc"
                                                        onAction="#handleFilterAuctions"
                                                        styleClass="dash-primary-button"/>

                                            </children>

                                        </HBox>

                                    </children>

                                </VBox>

                            </top>

                            <center>

                                <VBox styleClass="dash-table-wrap">

                                    <padding>
                                        <Insets top="0"
                                                right="24"
                                                bottom="24"
                                                left="24"/>
                                    </padding>

                                    <children>

                                        <TableView fx:id="auctionTable"
                                                   VBox.vgrow="ALWAYS"
                                                   styleClass="dash-table">

                                            <columns>

                                                <TableColumn fx:id="colAuctionItem"
                                                             text="Sản phẩm"
                                                             prefWidth="320"/>

                                                <TableColumn fx:id="colAuctionSeller"
                                                             text="Seller"
                                                             prefWidth="220"/>

                                                <TableColumn fx:id="colAuctionCurrentPrice"
                                                             text="Giá hiện tại"
                                                             prefWidth="220"/>

                                                <TableColumn fx:id="colAuctionStatus"
                                                             text="Trạng thái"
                                                             prefWidth="180"/>

                                                <TableColumn fx:id="colAuctionEndTime"
                                                             text="Kết thúc"
                                                             prefWidth="240"/>

                                            </columns>

                                        </TableView>

                                    </children>

                                </VBox>

                            </center>

                        </BorderPane>

                    </content>

                </Tab>

                <!-- ============================= -->
                <!-- REALTIME TAB -->
                <!-- ============================= -->

                <Tab fx:id="bidRealtimeTab"
                     text="Đặt bid realtime">

                    <content>

                        <ScrollPane fitToWidth="true"
                                    fitToHeight="true">

                            <content>

                                <VBox spacing="20"
                                      styleClass="dash-content-card">

                                    <padding>
                                        <Insets top="24"
                                                right="24"
                                                bottom="28"
                                                left="24"/>
                                    </padding>

                                    <children>

                                        <HBox spacing="20"
                                              alignment="TOP_CENTER">

                                            <children>

                                                <!-- LEFT -->

                                                <VBox spacing="16"
                                                      HBox.hgrow="ALWAYS"
                                                      styleClass="dash-detail-card">

                                                    <children>

                                                        <Label text="Chi tiết phiên đấu giá"
                                                               styleClass="dash-section-title"/>

                                                        <GridPane hgap="12"
                                                                  vgap="13">

                                                            <columnConstraints>

                                                                <ColumnConstraints percentWidth="32"/>

                                                                <ColumnConstraints percentWidth="68"/>

                                                            </columnConstraints>

                                                            <children>

                                                                <Label text="Sản phẩm"
                                                                       GridPane.rowIndex="0"/>

                                                                <Label fx:id="itemNameLabel"
                                                                       GridPane.rowIndex="0"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Mô tả"
                                                                       GridPane.rowIndex="1"/>

                                                                <Label fx:id="itemDescriptionLabel"
                                                                       wrapText="true"
                                                                       GridPane.rowIndex="1"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Giá hiện tại"
                                                                       GridPane.rowIndex="2"/>

                                                                <Label fx:id="currentPriceLabel"
                                                                       GridPane.rowIndex="2"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Người dẫn đầu"
                                                                       GridPane.rowIndex="3"/>

                                                                <Label fx:id="leaderLabel"
                                                                       GridPane.rowIndex="3"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Bắt đầu"
                                                                       GridPane.rowIndex="4"/>

                                                                <Label fx:id="startTimeLabel"
                                                                       GridPane.rowIndex="4"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Kết thúc"
                                                                       GridPane.rowIndex="5"/>

                                                                <Label fx:id="endTimeLabel"
                                                                       GridPane.rowIndex="5"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label text="Trạng thái"
                                                                       GridPane.rowIndex="6"/>

                                                                <Label fx:id="auctionStatusLabel"
                                                                       GridPane.rowIndex="6"
                                                                       GridPane.columnIndex="1"/>

                                                                <Label fx:id="startingPriceLabel"
                                                                       visible="false"
                                                                       managed="false"/>

                                                            </children>

                                                        </GridPane>

                                                    </children>

                                                </VBox>

                                                <!-- RIGHT -->

                                                <VBox spacing="16"
                                                      prefWidth="420"
                                                      styleClass="dash-bid-card">

                                                    <children>

                                                        <Label text="Đặt bid realtime"
                                                               styleClass="dash-section-title"/>

                                                        <TextField fx:id="manualBidField"
                                                                   promptText="Nhập số tiền bid"
                                                                   styleClass="dash-input"/>

                                                        <Button text="Đặt bid ngay"
                                                                maxWidth="Infinity"
                                                                onAction="#handlePlaceBid"
                                                                styleClass="dash-primary-button"/>

                                                        <Separator/>

                                                        <Label text="Auto Bid"/>

                                                        <TextField fx:id="autoBidMaxField"
                                                                   promptText="Giá tối đa"
                                                                   styleClass="dash-input"/>

                                                        <TextField fx:id="autoBidIncrementField"
                                                                   promptText="Bước nhảy"
                                                                   styleClass="dash-input"/>

                                                        <Button text="Bật Auto Bid"
                                                                onAction="#handleRegisterAutoBid"
                                                                styleClass="dash-secondary-button"/>

                                                        <Label fx:id="bidMessageLabel"
                                                               wrapText="true"
                                                               styleClass="success-label"/>

                                                    </children>

                                                </VBox>

                                            </children>

                                        </HBox>

                                    </children>

                                </VBox>

                            </content>

                        </ScrollPane>

                    </content>

                </Tab>

                <!-- ============================= -->
                <!-- BID HISTORY -->
                <!-- ============================= -->

                <Tab text="Lịch sử bid">

                    <content>

                        <VBox spacing="16"
                              styleClass="dash-content-card">

                            <padding>
                                <Insets top="24"
                                        right="24"
                                        bottom="24"
                                        left="24"/>
                            </padding>

                            <children>

                                <Label text="Lịch sử đặt bid"
                                       styleClass="dash-section-title"/>

                                <TableView fx:id="bidHistoryTable"
                                           VBox.vgrow="ALWAYS"
                                           styleClass="dash-table">

                                    <columns>

                                        <TableColumn fx:id="colBidTime"
                                                     text="Thời gian"
                                                     prefWidth="260"/>

                                        <TableColumn fx:id="colBidder"
                                                     text="Bidder"
                                                     prefWidth="220"/>

                                        <TableColumn fx:id="colBidAmount"
                                                     text="Số tiền"
                                                     prefWidth="240"/>

                                        <TableColumn fx:id="colBidType"
                                                     text="Loại bid"
                                                     prefWidth="180"/>

                                    </columns>

                                </TableView>

                            </children>

                        </VBox>

                    </content>

                </Tab>

                <!-- ============================= -->
                <!-- CHART -->
                <!-- ============================= -->

                <Tab text="Biểu đồ">

                    <content>

                        <VBox spacing="16"
                              styleClass="dash-content-card">

                            <padding>
                                <Insets top="24"
                                        right="24"
                                        bottom="24"
                                        left="24"/>
                            </padding>

                            <children>

                                <Label text="Biểu đồ realtime"
                                       styleClass="dash-section-title"/>

                                <LineChart fx:id="priceChart"
                                           animated="false"
                                           legendVisible="false"
                                           VBox.vgrow="ALWAYS">

                                    <xAxis>
                                        <NumberAxis fx:id="xAxis"
                                                    label="Lượt bid"/>
                                    </xAxis>

                                    <yAxis>
                                        <NumberAxis fx:id="yAxis"
                                                    label="Giá"/>
                                    </yAxis>

                                </LineChart>

                            </children>

                        </VBox>

                    </content>

                </Tab>

            </tabs>

        </TabPane>

    </center>

</BorderPane>