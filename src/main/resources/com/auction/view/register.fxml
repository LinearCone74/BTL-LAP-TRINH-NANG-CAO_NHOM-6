<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.RegisterController"
            styleClass="auth-root">

    <center>
        <GridPane styleClass="auth-layout">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <VBox GridPane.columnIndex="0"
                  alignment="CENTER_LEFT"
                  spacing="30"
                  styleClass="auth-brand-panel">

                <Region prefHeight="26"/>

                <Label text="AuctionHub"
                       styleClass="brand-logo"/>

                <Label text="Create enterprise auction account"
                       styleClass="brand-description"/>

                <VBox spacing="15"
                      styleClass="brand-features">
                    <Label text="• Manage auction lifecycle"
                           styleClass="brand-feature"/>
                    <Label text="• Participate in live bidding"
                           styleClass="brand-feature"/>
                    <Label text="• Monitor transaction history"
                           styleClass="brand-feature"/>
                    <Label text="• Secure marketplace access"
                           styleClass="brand-feature"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Secure Marketplace System"
                       styleClass="brand-footer"/>

                <padding>
                    <Insets top="88" right="64" bottom="72" left="72"/>
                </padding>
            </VBox>

            <StackPane GridPane.columnIndex="1"
                       styleClass="auth-form-area">

                <VBox alignment="CENTER_LEFT"
                      spacing="0"
                      maxWidth="480"
                      translateY="24"
                      styleClass="auth-form">

                    <Label text="Register"
                           styleClass="form-title"/>

                    <Label text="Create a new AuctionHub account"
                           styleClass="form-subtitle"/>

                    <Region prefHeight="34"/>

                    <Label text="Username"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <TextField fx:id="usernameField"
                               promptText="Username"
                               styleClass="auth-input"/>

                    <Region prefHeight="22"/>

                    <Label text="Password"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Password"
                                   styleClass="auth-input"/>

                    <Region prefHeight="22"/>

                    <Label text="Full Name"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <TextField fx:id="fullNameField"
                               promptText="Full name"
                               styleClass="auth-input"/>

                    <Region prefHeight="22"/>

                    <Label text="Email"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <TextField fx:id="emailField"
                               promptText="Email address"
                               styleClass="auth-input"/>

                    <Region prefHeight="22"/>

                    <Label text="Role"
                           styleClass="field-label"/>
                    <Region prefHeight="8"/>
                    <ComboBox fx:id="roleComboBox"
                              prefWidth="260"
                              minWidth="260"
                              prefHeight="52"
                              styleClass="auth-combo"/>

                    <Region prefHeight="34"/>

                    <Button text="Create Account"
                            prefHeight="50"
                            maxWidth="9999"
                            onAction="#handleRegister"
                            styleClass="primary-button"/>

                    <Region prefHeight="12"/>

                    <Button text="Back to Login"
                            prefHeight="50"
                            maxWidth="9999"
                            onAction="#goToLogin"
                            styleClass="secondary-button"/>

                    <Region prefHeight="18"/>

                    <Label fx:id="messageLabel"
                           wrapText="true"
                           styleClass="message-label"/>
                </VBox>
            </StackPane>
        </GridPane>
    </center>
</BorderPane>