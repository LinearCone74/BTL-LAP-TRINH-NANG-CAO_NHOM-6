<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.RegisterController"
            prefWidth="1200"
            prefHeight="800"
            styleClass="login-root">

    <center>
        <HBox alignment="CENTER" styleClass="login-shell">
            <children>

                <VBox spacing="18" styleClass="login-brand">
                    <children>
                        <Label text="🔨" styleClass="login-icon"/>

                        <Label text="AuctionHub"
                               styleClass="login-title"
                               maxWidth="Infinity"/>

                        <Label text="Marketplace đấu giá thời gian thực"
                               wrapText="true"
                               styleClass="login-subtitle"/>

                        <Pane VBox.vgrow="ALWAYS"/>

                        <Label text="List items • Place bids • Close deals"
                               styleClass="login-slogan"/>
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="login-form">
                    <children>

                        <VBox spacing="4" styleClass="login-header">
                            <children>
                                <Label text="Tạo tài khoản"
                                       styleClass="form-title"/>

                                <Label text="Đăng ký để mua, bán và tham gia đấu giá"
                                       styleClass="form-subtitle"/>
                            </children>
                        </VBox>

                        <VBox spacing="5">
                            <children>
                                <Label text="Tên đăng nhập" styleClass="field-label"/>
                                <TextField fx:id="usernameField" promptText="Nhập username"/>
                            </children>
                        </VBox>

                        <VBox spacing="5">
                            <children>
                                <Label text="Mật khẩu" styleClass="field-label"/>
                                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"/>
                            </children>
                        </VBox>

                        <VBox spacing="5">
                            <children>
                                <Label text="Họ và tên" styleClass="field-label"/>
                                <TextField fx:id="fullNameField" promptText="Nhập họ tên"/>
                            </children>
                        </VBox>

                        <VBox spacing="5">
                            <children>
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="emailField" promptText="Nhập email"/>
                            </children>
                        </VBox>

                        <VBox spacing="5">
                            <children>
                                <Label text="Vai trò" styleClass="field-label"/>
                                <ComboBox fx:id="roleComboBox"
                                          promptText="Chọn vai trò"
                                          maxWidth="Infinity"/>
                            </children>
                        </VBox>

                        <Label fx:id="messageLabel" styleClass="success-label" wrapText="true"/>

                        <HBox spacing="12">
                            <children>
                                <Button text="Tạo tài khoản"
                                        onAction="#handleRegister"
                                        styleClass="primary-button"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>

                                <Button text="Về đăng nhập"
                                        onAction="#goToLogin"
                                        styleClass="secondary-button"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>